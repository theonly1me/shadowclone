{
  "name": "@shadowclone/cli",
  "version": "0.0.16",
  "module": "src/cli/index.ts",
  "type": "module",
  "packageManager": "bun@1.4.2",
  "bin": {
    "shadowclone": "bin/shadowclone.mjs"
  },
  "scripts": {
    "start": "bun run src/cli/index.ts",
    "cli": "bun run src/cli/index.ts",
    "check": "bun run typecheck && bun run lint && bun test",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write",
    "format:check": "prettier --check",
    "lint": "biome lint --error-on-warnings --diagnostic-level=warn . && bun run scripts/conventions.ts",
    "lint:fix": "biome lint --write .",
    "build": "bun run scripts/build.ts",
    "prepack": "bun run build"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@types/bun": "latest",
    "@types/d3-hierarchy": "^3.1.7",
    "@types/d3-selection": "^3.0.12",
    "@types/d3-zoom": "^3.0.9",
    "prettier": "3.9.9",
    "typescript": "~5.9"
  },
  "description": "Turns how you work into a portable, tested environment for the coding agents you already use.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/theonly1me/shadowclone.git"
  },
  "homepage": "https://shadowclone.co",
  "bugs": {
    "url": "https://github.com/theonly1me/shadowclone/issues"
  },
  "keywords": [
    "claude-code",
    "codex",
    "cursor",
    "agent",
    "subagent",
    "local-first"
  ],
  "files": [
    "bin",
    "dist",
    "preferences",
    "skills",
    "plugins",
    ".claude-plugin",
    "README.md",
    "PRIVACY.md",
    "evals.md",
    "LICENSE"
  ],
  "dependencies": {
    "bun": "^1.4.2",
    "commander": "^15.0.0",
    "d3-hierarchy": "^3.1.2",
    "d3-selection": "^3.0.0",
    "d3-zoom": "^3.0.0",
    "smol-toml": "^1.8.0",
    "zod": "^4.5.4"
  }
}
