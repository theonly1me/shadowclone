{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "src/mcp/server.ts",
    "src/web/client/main.ts",
    "scripts/*.ts",
    "plugins/shadowclone/skills/*/scripts/*.mjs",
    "src/**/*.test.ts",
    "evals/**/*.test.ts",
    "evals/run.ts",
    "evals/work/prepare.ts",
    "evals/work/scaffold/cli.ts",
    "evals/work/fakeGh/main.ts",
    "evals/work/regrade.ts",
    "evals/pr-review/cli.ts",
    "evals/pr-review/mine/index.ts"
  ],
  "project": [
    "src/**/*.ts",
    "evals/**/*.ts",
    "scripts/**/*.ts",
    "bin/*.mjs",
    "plugins/**/*.mjs"
  ],
  "ignoreBinaries": [
    "shadowclone"
  ],
  "rules": {
    "exports": "off",
    "types": "off",
    "nsExports": "off",
    "nsTypes": "off",
    "enumMembers": "off",
    "duplicates": "off"
  }
}
