{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreBinaries": [
    "shadowclone"
  ],
  "rules": {
    "exports": "off",
    "types": "off",
    "nsExports": "off",
    "nsTypes": "off",
    "enumMembers": "off",
    "duplicates": "off"
  },
  "workspaces": {
    ".": {
      "entry": [
        "src/mcp/server.ts",
        "src/web/client/main.ts",
        "scripts/*.ts",
        "plugins/shadowclone/skills/*/scripts/*.mjs",
        "src/**/*.test.ts"
      ],
      "project": [
        "src/**/*.ts",
        "scripts/**/*.ts",
        "bin/*.mjs",
        "plugins/**/*.mjs"
      ],
      "ignoreDependencies": [
        "commander"
      ]
    },
    "tooling": {
      "entry": [
        "src/*.ts",
        "src/**/*.test.ts"
      ],
      "project": [
        "src/**/*.ts"
      ]
    },
    "evals": {
      "entry": [
        "**/*.test.ts",
        "run.ts",
        "work/run.ts",
        "work/prepare.ts",
        "work/scaffold/cli.ts",
        "work/fakeGh/main.ts",
        "work/regrade.ts",
        "pr-review/cli.ts",
        "pr-review/mine/index.ts"
      ],
      "project": [
        "**/*.ts"
      ]
    }
  }
}
